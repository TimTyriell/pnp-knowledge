# Guard switches for this checkout.
#
#   cp .claude/guards.env.example .claude/guards.env   (gitignored)
#
# 1 = allowed, anything else = blocked. Read on every tool call, so a change
# applies at once, no restart. Claude can't write .claude/guards.env (the guard
# blocks it); you flip the switches. Set them back to 0 when you're done.
# A blocked call names the switch it needs. Rules and why: .claude/hooks/guard.ps1
# and pnp-knowledge docs/architecture/ADR-005-ai-native-delivery.md.

# pnp run / extract / state / dedup without --estimate (DeepSeek, costs money;
# a cold rebuild is ~$6.50), and changing a *_PROMPT_VERSION in prompts.py.
PNP_ALLOW_PAID=0

# Hand edits under knowledge/ (normally written by `pnp run`; entity_rules.yaml
# is always editable).
PNP_ALLOW_BUNDLE_EDIT=0

# Commit directly on main (default: branch first, from a git worktree).
PNP_ALLOW_MAIN_COMMIT=0

# Let Claude edit .claude/hooks/, .claude/settings.json and this file.
PNP_ALLOW_GUARD_EDIT=0
