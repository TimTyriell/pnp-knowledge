{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "sessionId",
      "type": "promptString",
      "description": "session_id (date), e.g. 2025-03-26",
      "default": "2025-03-26"
    },
    {
      "id": "exportOutput",
      "type": "promptString",
      "description": "export output path (nodes+relationships JSON, no embeddings)",
      "default": "docs/data_export/neo4j_export.json"
    },
    {
      "id": "exportUri",
      "type": "pickString",
      "description": "which Neo4j to export",
      "options": [
        "bolt://localhost:7687",
        "bolt://localhost:7688",
        "bolt://localhost:7689"
      ],
      "default": "bolt://localhost:7687"
    }
  ],
  "configurations": [
    {
      "name": "Debug: Custom pipeline (single session)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "pnp_graph.cli",
      "args": ["ingest", "--only", "${input:sessionId}"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug: Custom pipeline (all sessions)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "pnp_graph.cli",
      "args": ["ingest"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug: Custom pipeline (flagship-flash, single session)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "pnp_graph.cli",
      "args": ["ingest", "--only", "${input:sessionId}"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src", "PNP_PROFILE": "flagship", "DEEPSEEK_MODEL": "deepseek-v4-flash" },
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug: Custom pipeline (flagship-flash, all sessions)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "pnp_graph.cli",
      "args": ["ingest"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src", "PNP_PROFILE": "flagship", "DEEPSEEK_MODEL": "deepseek-v4-flash" },
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug: Custom pipeline (flagship-pro, single session)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "pnp_graph.cli",
      "args": ["ingest", "--only", "${input:sessionId}"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src", "PNP_PROFILE": "flagship", "DEEPSEEK_MODEL": "deepseek-v4-pro" },
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug: Custom pipeline (flagship-pro, all sessions)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "pnp_graph.cli",
      "args": ["ingest"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src", "PNP_PROFILE": "flagship", "DEEPSEEK_MODEL": "deepseek-v4-pro" },
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Run: Export Neo4j graph (no embeddings)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/export_graph.py",
      "args": ["${input:exportOutput}", "--uri", "${input:exportUri}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
