# pnp-knowledge — copy to .env and set DEEPSEEK_API_KEY.
# Commented entries show defaults; uncomment only to override.

# ─── LLM ─────────────────────────────────────────────────────────────────────

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Extraction and deep-tier synthesis.
DEEPSEEK_MODEL=deepseek-v4-pro

# Standard/brief-tier synthesis. See config.py `for_tier()`.
DEEPSEEK_LIGHT_MODEL=deepseek-v4-flash

# Billing note: DeepSeek charges double between 01:00-04:00 and 06:00-10:00
# UTC on weekdays. Everything else, weekends included, is off-peak. A full
# rebuild costs ~$8 off-peak and ~$15 at peak -- see
# docs/architecture/MIGRATION-prompt-v6.md before triggering one.

# ─── Pipeline (services/kb) ──────────────────────────────────────────────────

# Transcripts from the pnp-crawl repo. Absolute path, no default.
#PNP_TRANSCRIPT_DIR=

# Unset resolves the repo's own bundle via knowledge/entity_registry.yaml.
# A relative override builds a throwaway campaign under the cwd instead.
#PNP_BUNDLE_DIR=

# LLM response cache. Invalidated wholesale by a PROMPT_VERSION bump.
#PNP_CACHE_DIR=./.cache

# last_run.json + history.jsonl (see docs/architecture/status-schema.md).
#PNP_STATE_DIR=./state

# ─── Services ────────────────────────────────────────────────────────────────

#PNP_KB_URL=http://127.0.0.1:8070

# Dashboard's sibling checkouts.
#PNP_CRAWL_DIR=../pnp-crawl
#PNP_EXPORT_DIR=../pnp-export-data
#PNP_KNOWLEDGE_DIR=./knowledge

# ─── Frozen GraphRAG (graph/, see ADR-002) ───────────────────────────────────
# Not required by the active system. Containers run NEO4J_AUTH=none.

# local (Ollama) | flagship (DeepSeek)
#PNP_PROFILE=local
#REPORT_NEO4J_URL=bolt://localhost:7689
#AIKG_DIR=../ai-knowledge-graph
#AIKG_NEO4J_URL=bolt://localhost:7688
