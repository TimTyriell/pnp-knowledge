# DeepSeek API configuration for pnp-okf.
# Copy to .env and fill in. Matches the pnp-graph-service flagship profile
# (see C:\dev\pnp\pnp-graph-service\CLAUDE.md): DeepSeek's OpenAI-compatible
# endpoint, API-key auth only (no keyless/Entra ID option).

# DeepSeek API key (required).
DEEPSEEK_API_KEY=your-key-here

# DeepSeek API base URL (rarely needs changing).
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model to use for extraction and synthesis.
DEEPSEEK_MODEL=deepseek-chat

# --- Pipeline paths (optional; can be overridden by CLI flags) ---
# Directory holding the *.json transcript files. Machine-specific: these are
# produced by the separate pnp-crawl repo and are not part of this one. Set it
# to an ABSOLUTE path -- a relative one resolves against your shell's cwd, not
# the repo.
#PNP_TRANSCRIPT_DIR=/absolute/path/to/pnp-crawl/transcripts_final
#
# Output bundle directory. LEAVE THIS UNSET unless you deliberately want a
# bundle somewhere other than knowledge/bundle/splitter_des_ewigen. It is
# resolved against the cwd, and the registry, entity_rules.yaml and sources/
# are all derived from it -- so a relative value like "./bundle/..." makes
# `cd services/kb && pnp run` build a throwaway campaign under services/kb
# with none of the hand-authored rules applied. Unset, the CLI finds the
# repo's own bundle by walking up for knowledge/entity_registry.yaml.
#PNP_BUNDLE_DIR=
